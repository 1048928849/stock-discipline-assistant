APP_NAME=股票纪律助手
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./stock_assistant.db
# MySQL 示例：mysql+pymysql://stock_user:change_me@mysql:3306/stock_assistant?charset=utf8mb4
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Gemini 推荐：gemini-3.6-flash（以账号 models 列表实际可用项为准）
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=40000
LLM_DAILY_LIMIT=20
LLM_CACHE_HOURS=24
X_COOKIE=
SCHEDULER_ENABLED=true
X_SYNC_MINUTES=15
