APP_NAME=股票纪律助手
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./stock_assistant.db
# MySQL 示例：mysql+pymysql://stock_user:change_me@mysql:3306/stock_assistant?charset=utf8mb4
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Gemini 推荐：gemini-3.6-flash（以账号 models 列表实际可用项为准）
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=40000
LLM_DAILY_LIMIT=20
LLM_CACHE_HOURS=24
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=2
MARKET_DATA_FRESH_HOURS=36
RESEARCH_PROFILE_FRESH_HOURS=168
RESEARCH_FINANCIAL_FRESH_HOURS=168
RESEARCH_VALUATION_FRESH_HOURS=36
RESEARCH_ANNOUNCEMENT_FRESH_HOURS=24
# 可选Provider；未配置或未启用时会安全跳过，不影响免费数据源
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
TUSHARE_PRIORITY=20
PROFESSIONAL_MARKET_API_ENABLED=false
PROFESSIONAL_MARKET_API_PRIORITY=10
PROFESSIONAL_MARKET_API_URL=
PROFESSIONAL_MARKET_API_KEY=
NEWS_API_ENABLED=false
NEWS_API_PRIORITY=30
NEWS_API_URL=
NEWS_API_KEY=
X_COOKIE=
SCHEDULER_ENABLED=true
X_SYNC_MINUTES=15
